# Copy this file to .env and replace the values for your local PostgreSQL instance.
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_postgres_password
JWT_SECRET=replace_with_a_long_random_secret
# Set this to your Vercel URL in the deployed Render service (no trailing slash).
FRONTEND_URL=http://localhost:3000
